
use builtin;
use str;

set edit:completion:arg-completer[firestone] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'firestone'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'firestone'= {
            cand --home 'Override the Firestone home root (config, data, and runtime)'
            cand --json 'Print events as newline-delimited JSON and disable human output'
            cand -q 'Print only errors and command results'
            cand --quiet 'Print only errors and command results'
            cand -v 'Increase log detail. Pass twice for debug output'
            cand --verbose 'Increase log detail. Pass twice for debug output'
            cand --no-color 'Disable colored output'
            cand -y 'Assume yes when a command may prompt'
            cand --yes 'Assume yes when a command may prompt'
            cand -h 'Print help'
            cand --help 'Print help'
            cand -V 'Print version'
            cand --version 'Print version'
            cand run 'Create or reuse a machine, start it, and open an SSH shell'
            cand create 'Create a machine definition without booting it'
            cand start 'Start a machine and wait for SSH readiness'
            cand stop 'Stop a machine'
            cand restart 'Stop and start a machine'
            cand rm 'Stop and remove one or more machines'
            cand ls 'List machines'
            cand list 'List machines'
            cand show 'Show a machine''s specification and runtime state'
            cand edit 'Edit and validate a machine''s firestone.toml'
            cand shell 'Open SSH over the machine''s private vsock transport'
            cand ssh 'Open SSH over the machine''s private vsock transport'
            cand ssh-config 'Print an OpenSSH Host block for the machine'
            cand console 'Attach to the machine''s hvc0 console'
            cand logs 'Print a bounded machine log'
            cand catalog 'Print the merged built-in and user image catalog'
            cand images 'Manage the owned image store'
            cand doctor 'Check host requirements and optional safe repairs'
            cand completions 'Generate a shell completion script on stdout'
            cand version 'Print Firestone, pinned dependency, and resolved path versions'
            cand serve 'Run the stateless REST API over a private Unix socket or loopback port'
            cand ui 'Open the Firestone web interface on a loopback port'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'firestone;run'= {
            cand --name 'Name a machine created from an image reference'
            cand --arch 'Set the guest architecture; it must match the host'
            cand --cpus 'Set the number of virtual CPUs'
            cand --memory 'Set guest memory, for example 2G or 2048M'
            cand --disk 'Set writable disk capacity, for example 20G'
            cand --user 'Set the guest login user created by Firestone provisioning'
            cand --net 'Select passt, tap, or no network'
            cand -p 'Forward a host port or range to the guest; repeat as needed'
            cand --forward 'Forward a host port or range to the guest; repeat as needed'
            cand --tap 'Use an existing host tap interface with --net tap'
            cand --network-mac 'Set a fixed guest network MAC address'
            cand --mount 'Share a host directory with the guest; repeat as needed'
            cand --user-data 'Add a cloud-init user-data file'
            cand --cloud-init-network-config 'Add a cloud-init network-config file'
            cand --ssh-key 'Add an OpenSSH public-key file; repeat as needed'
            cand --vmm-binary 'Use a custom cloud-hypervisor executable'
            cand --vmm-firmware 'Select auto, rhf, edk2, or a firmware file'
            cand --vmm-arg 'Append one cloud-hypervisor argument; repeat as needed'
            cand --vmm-config 'Merge a JSON object into the generated VMM configuration'
            cand --clear 'Clear an inherited optional field; repeat as needed'
            cand --home 'Override the Firestone home root (config, data, and runtime)'
            cand --rm 'Remove a machine created by this invocation after SSH exits'
            cand --no-provisioning 'Disable Firestone''s built-in guest provisioning'
            cand --json 'Print events as newline-delimited JSON and disable human output'
            cand -q 'Print only errors and command results'
            cand --quiet 'Print only errors and command results'
            cand -v 'Increase log detail. Pass twice for debug output'
            cand --verbose 'Increase log detail. Pass twice for debug output'
            cand --no-color 'Disable colored output'
            cand -y 'Assume yes when a command may prompt'
            cand --yes 'Assume yes when a command may prompt'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'firestone;create'= {
            cand --image 'Select the image by catalog reference, HTTPS URL, or local file'
            cand -f 'Layer an existing machine specification below command-line flags'
            cand --file 'Layer an existing machine specification below command-line flags'
            cand --arch 'Set the guest architecture; it must match the host'
            cand --cpus 'Set the number of virtual CPUs'
            cand --memory 'Set guest memory, for example 2G or 2048M'
            cand --disk 'Set writable disk capacity, for example 20G'
            cand --user 'Set the guest login user created by Firestone provisioning'
            cand --net 'Select passt, tap, or no network'
            cand -p 'Forward a host port or range to the guest; repeat as needed'
            cand --forward 'Forward a host port or range to the guest; repeat as needed'
            cand --tap 'Use an existing host tap interface with --net tap'
            cand --network-mac 'Set a fixed guest network MAC address'
