            [CompletionResult]::new('--version', '--version', [CompletionResultType]::ParameterName, 'Print version')
            [CompletionResult]::new('run', 'run', [CompletionResultType]::ParameterValue, 'Create or reuse a machine, start it, and open an SSH shell')
            [CompletionResult]::new('create', 'create', [CompletionResultType]::ParameterValue, 'Create a machine definition without booting it')
            [CompletionResult]::new('start', 'start', [CompletionResultType]::ParameterValue, 'Start a machine and wait for SSH readiness')
            [CompletionResult]::new('stop', 'stop', [CompletionResultType]::ParameterValue, 'Stop a machine')
