# Reproducible Firestone Linux release inputs.
#
# FIRESTONE_VERSION and CARGO_LOCK_SHA256 are rewritten by the release
# workflow on a tagged run. crates/firestone/tests/release.rs requires this
# file to agree with Cargo.toml and Cargo.lock, so drift fails on every
# change rather than in a release build.
FIRESTONE_VERSION=0.1.3
RUST_VERSION=1.85.0
RUSTC_COMMIT=4d91de4e48198da2e33413efdcd9cd2cc0c46688
CARGO_COMMIT=d73d2caf9e41a39daf2a8d6ce60ec80bf354d2a7
RUST_IMAGE=rust@sha256:bea885d2711087e67a9f7a7cd1a164976f4c35389478512af170730014d2452a
GCC_VERSION=14.2.0
BINUTILS_VERSION=2.43.1
CARGO_LOCK_SHA256=d4b6ac50bdabad72d458811d4196d5e052df1ef15f34ba701755cdad5f282fc5
DEPS_TOML_SHA256=4d58a7623e083da70bf02de702b17d3840ba99fdccffc7ebf110a4ccc9801a65
MUSL_HEADERS_VERSION=1.2.5-r11
MUSL_HEADERS_X86_64_URL=https://dl-cdn.alpinelinux.org/alpine/v3.21/main/x86_64/musl-dev-1.2.5-r11.apk
MUSL_HEADERS_X86_64_SHA256=d3b5ab01046a92b9a168b790f516606e320f015cbd4deeb584c5e115a02124ba
